<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>NSPrivacyTracking</key>
  <false/>
  <key>NSPrivacyTrackingDomains</key>
  <array/>
  <key>NSPrivacyCollectedDataTypes</key>
  <array/>
  <!-- FileTimestamp C617.1: app-owned storage/export metadata. 3B52.1:
       metadata for files explicitly selected by the user for import.
       SystemBootTime 35F9.1: Rust/Tokio elapsed-time and timeout timers;
       no system boot-time value is exported.
       DiskSpace E174.1: file_exports.rs checks the selected Documents volume
       before publishing an iOS export and rejects insufficient space with a
       visible export error. No capacity values are displayed or transmitted.
       SQLite/rustix also link filesystem-query APIs; symbol presence alone
       was not used to infer a disk-space purpose. No first-party or iOS
       Tauri/Wry UserDefaults access was found; do not add CA92.1 speculatively. -->
  <key>NSPrivacyAccessedAPITypes</key>
  <array>
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>C617.1</string>
        <string>3B52.1</string>
      </array>
    </dict>
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>35F9.1</string>
      </array>
    </dict>
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>E174.1</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
