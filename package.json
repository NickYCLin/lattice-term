{
  "name": "lattice-term",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "description": "A secure, cross-platform workspace for local AI CLIs, SSH, SFTP, RDP, and remote desktop access.",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/NickYCLin/lattice-term.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && npm run bundle:check",
    "bundle:check": "node scripts/check-frontend-entry-size.mjs",
    "build:rdp": "node scripts/build-rdp-engine.mjs",
    "build:rdp:release": "node scripts/build-rdp-engine.mjs --release",
    "build:remote": "node scripts/build-remote-agent.mjs",
    "build:remote:release": "node scripts/build-remote-agent.mjs --release",
    "build:sidecars": "npm run build:rdp && npm run build:vnc && npm run build:remote",
    "build:sidecars:release": "npm run build:rdp:release && npm run build:vnc:release && npm run build:remote:release",
    "test": "vitest run",
    "actions:check": "node scripts/check-github-actions-pinning.mjs",
    "version:sync-lock": "node scripts/sync-cargo-lock-version.mjs",
    "version:check": "node scripts/check-version-sync.mjs",
    "release:normalize-changelog": "node scripts/normalize-release-changelog.mjs",
    "check": "npm run version:check && npm run actions:check && npm run test && npm run build",
    "preview": "vite preview",
    "tauri": "tauri",
    "ios:sync": "node scripts/ios-release.mjs sync",
    "ios:simulator": "node scripts/ios-release.mjs simulator",
    "ios:simulator:release": "node scripts/ios-release.mjs simulator-release",
    "ios:device:unsigned": "node scripts/ios-release.mjs device-unsigned",
    "ios:prepare": "node scripts/ios-release.mjs prepare",
    "ios:preflight": "node scripts/ios-release.mjs preflight",
    "ios:build": "node scripts/ios-release.mjs build",
    "ios:check": "vitest run scripts/ios-config.test.mjs scripts/ios-release.test.mjs src/app/platformCapabilities.test.ts src/app/fileExport.test.ts src/views/ConnectionsView.render.test.tsx src/views/SettingsView.render.test.tsx",
    "build:vnc": "node scripts/build-vnc-engine.mjs",
    "build:vnc:release": "node scripts/build-vnc-engine.mjs --release"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "6.1.0-beta.304",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
